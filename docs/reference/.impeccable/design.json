      "description": "Stable author identity without an image asset.",
      "html": "<span class=\"ds-avatar\" aria-label=\"Nina Park\">NP</span>",
      "css": ".ds-avatar{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:inline-flex;align-items:center;justify-content:center;border-radius:10px;width:33px;height:33px;font-size:11px;font-weight:600;letter-spacing:.01em;color:#666a43;background:#e6e7da;user-select:none}"
    }
