  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Compact dialog action.",
      "html": "<button class=\"ds-button-primary\">Create room</button>",
      "css": ".ds-button-primary{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;border:0;cursor:pointer;padding:9px 15px;border-radius:6px;font-size:12px;font-weight:550;background:var(--accent,#a94329);color:var(--surface,#fff)}.ds-button-primary:hover{filter:brightness(.96)}.ds-button-primary:focus-visible{outline:2px solid var(--focus,#a94329);outline-offset:3px;}.ds-button-primary:active{transform:translateY(1px)}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Compact dialog action.",
      "html": "<button class=\"ds-button-secondary\">Cancel</button>",
      "css": ".ds-button-secondary{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;border:0;cursor:pointer;padding:9px 15px;border-radius:6px;font-size:12px;font-weight:550;background:var(--hover,#eeece7);color:var(--ink,#292b29)}.ds-button-secondary:hover{filter:brightness(.96)}.ds-button-secondary:focus-visible{outline:2px solid var(--focus,#a94329);outline-offset:3px;}.ds-button-secondary:active{transform:translateY(1px)}"
    },
    {
      "name": "Send button",
      "kind": "button",
      "refersTo": "send-button",
      "description": "Primary composer action.",
      "html": "<button class=\"ds-send\">Send<svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 19V5m-6 6 6-6 6 6\"/></svg></button>",
      "css": ".ds-send{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:inline-flex;align-items:center;gap:9px;border:0;cursor:pointer;background:var(--accent,#a94329);color:var(--surface,#fff);height:30px;padding:0 11px;border-radius:6px;font-size:11px;font-weight:550}.ds-send .ds-icon{width:14px;height:14px}.ds-send:hover:not(:disabled){background:var(--accent-hover,#913820)}.ds-send:focus-visible{outline:2px solid var(--focus,#a94329);outline-offset:3px;}.ds-send:active:not(:disabled){transform:translateY(1px)}.ds-send:disabled{opacity:.4;cursor:default}"
    },
    {
      "name": "Icon button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "Compact secondary action.",
      "html": "<button class=\"ds-icon-button\" aria-label=\"Search\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 4.5 4.5\"/></svg></button>",
      "css": ".ds-icon-button{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;padding:0;border:0;border-radius:6px;cursor:pointer;color:var(--secondary,#646861);background:none;transition:background 120ms,color 120ms}.ds-icon-button .ds-icon{width:18px;height:18px}.ds-icon-button:hover{background:var(--hover,#eeece7);color:var(--ink,#292b29)}.ds-icon-button:focus-visible{outline:2px solid var(--focus,#a94329);outline-offset:3px;}.ds-icon-button:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-icon-button{transition:none}}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "text-field",
      "description": "Room and profile text entry.",
      "html": "<label class=\"ds-field-label\" for=\"ds-room-name\">Room name</label><input class=\"ds-field\" id=\"ds-room-name\" value=\"General\">",
      "css": ".ds-field-label{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:block;font-size:12px;font-weight:550;margin:18px 0 8px;color:var(--ink,#292b29)}.ds-field{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;width:100%;border:1px solid var(--line,#e9e7e2);padding:10px 11px;border-radius:6px;background:var(--subtle,#faf9f7);color:var(--ink,#292b29);font-size:13px;caret-color:var(--accent,#a94329)}.ds-field:focus-visible{outline:2px solid var(--focus,#a94329);outline-offset:3px;}"
    },
    {
      "name": "Room navigation",
      "kind": "nav",
      "refersTo": "room-row",
      "description": "Selected room and ordinary room with unread count.",
      "html": "<nav class=\"ds-rooms\" aria-label=\"Rooms\"><button class=\"ds-room ds-room-active\" aria-current=\"page\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 3 8 21M16 3l-2 18M4 9h17M3 15h17\"/></svg><span>General</span></button><button class=\"ds-room\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 3 8 21M16 3l-2 18M4 9h17M3 15h17\"/></svg><span>Development</span><span class=\"ds-room-count\">3</span></button></nav>",
      "css": ".ds-rooms{display:flex;flex-direction:column;gap:3px;max-width:246px}.ds-room{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:flex;align-items:center;gap:10px;text-align:left;width:100%;padding:10px 12px;min-height:39px;border:0;background:none;border-radius:6px;cursor:pointer;color:var(--secondary,#646861);font-size:13px}.ds-room .ds-icon{width:16px;height:16px;color:var(--muted,#696e64)}.ds-room:hover{background:var(--hover,#eeece7)}.ds-room.ds-room-active{background:var(--accent-wash,#f0e1d8);color:var(--accent,#a94329);font-weight:600}.ds-room-active .ds-icon{color:var(--accent,#a94329)}.ds-room:focus-visible{outline:2px solid var(--focus,#a94329);outline-offset:3px;}.ds-room:active{transform:translateY(1px)}.ds-room-count{margin-left:auto;min-width:19px;height:18px;border-radius:4px;text-align:center;padding:2px 4px;background:var(--line,#e9e7e2);color:var(--secondary,#646861);font-size:11px;font-weight:600}"
    },
    {
      "name": "Unread badge",
      "kind": "chip",
      "refersTo": "unread-badge",
      "description": "Compact room unread count.",
      "html": "<span class=\"ds-unread\" aria-label=\"3 unread messages\">3</span>",
      "css": ".ds-unread{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:inline-block;min-width:19px;height:18px;border-radius:4px;text-align:center;padding:2px 4px;background:var(--line,#e9e7e2);color:var(--secondary,#646861);font-size:11px;font-weight:600}"
    },
    {
      "name": "Shared link",
      "kind": "card",
      "refersTo": "shared-link",
      "description": "A readable title and domain for shared URLs.",
      "html": "<a class=\"ds-link\" href=\"https://doc.rust-lang.org/book/\" target=\"_blank\" rel=\"noopener noreferrer\"><span class=\"ds-link-mark\">&lt;/&gt;</span><span class=\"ds-link-detail\"><strong>The Rust Programming Language</strong><small>doc.rust-lang.org</small></span><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 3h7v7m0-7L10 14M10 4H4v16h16v-6\"/></svg></a>",
      "css": ".ds-link{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;max-width:540px;display:flex;align-items:center;gap:12px;padding:11px 13px;border:1px solid var(--line,#e9e7e2);border-radius:8px;text-decoration:none;color:var(--ink,#292b29)}.ds-link:hover{background:var(--hover,#eeece7)}.ds-link:focus-visible{outline:2px solid var(--focus,#a94329);outline-offset:3px;}.ds-link-mark{background:var(--subtle,#faf9f7);width:34px;height:34px;border-radius:6px;display:flex;align-items:center;justify-content:center;font:500 11px ui-monospace,monospace;flex-shrink:0}.ds-link-detail strong{font-size:12px;display:block;font-weight:550}.ds-link-detail small{display:block;font-size:11px;color:var(--secondary,#646861);margin-top:4px}.ds-link .ds-icon{margin-left:auto;width:14px;height:14px;color:var(--muted,#696e64)}"
    },
    {
      "name": "Code snippet",
      "kind": "custom",
      "refersTo": "code-block",
      "description": "Dark code container with a persistent copy action.",
      "html": "<div class=\"ds-code\"><div class=\"ds-code-header\"><span>Code</span><button class=\"ds-code-copy\" aria-label=\"Copy code snippet\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"8\" y=\"8\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M15 5V4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h1\"/></svg><span>Copy code</span></button></div><pre><code>npm run dev\n# Open the local preview</code></pre></div>",
      "css": ".ds-code{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;max-width:625px;border-radius:8px;background:var(--code,#252a29);color:var(--code-ink,#e6eae4);overflow:hidden}.ds-code-header{height:36px;display:flex;justify-content:space-between;align-items:center;padding:0 15px;color:#bbc3b9;font-size:11px;border-bottom:1px solid #ffffff0d}.ds-code-copy{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:flex;align-items:center;gap:5px;font-size:11px;color:#d0d8cd;background:none;border:0;cursor:pointer;padding:4px 6px;border-radius:4px}.ds-code-copy:hover{background:#ffffff12}.ds-code-copy:focus-visible{outline:2px solid var(--focus,#a94329);outline-offset:3px;}.ds-code-copy:active{transform:translateY(1px)}.ds-code-copy .ds-icon{width:13px;height:13px}.ds-code pre{padding:15px 17px 18px;margin:0;font:11.5px/1.95 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;tab-size:2}"
    },
    {
      "name": "Initial avatar",
      "kind": "custom",
